# Chave da API do Gemini (Google AI Studio) - usada para detectar os highlights
GEMINI_API_KEY=AI ...

# Modelo Gemini usado para escolher os highlights (opcional)
GEMINI_MODEL=gemini-3.5-flash

# Tamanho do modelo Whisper local: tiny, base, small, medium, large-v3
# "small" roda bem mais rapido em CPU que "medium"; suba de tamanho so quando
# a qualidade da transcricao/highlights precisar de mais precisao.
WHISPER_MODEL_SIZE=small

# Dispositivo do Whisper: auto, cpu, cuda
WHISPER_DEVICE=auto

# Tipo de computacao do faster-whisper: default, int8, float16, float32
# "default" deixa o CTranslate2 escolher automaticamente pro device configurado.
WHISPER_COMPUTE_TYPE=default

# Threads de CPU usadas pelo faster-whisper (so importa quando roda em CPU).
# Benchmark real (2026-08-01, CPU 4 nucleos/8 threads): 4 explicito foi ~9%
# mais rapido que o padrao da lib e que usar os 8 threads logicos via SMT.
# Ajuste pro numero de NUCLEOS FISICOS da sua CPU, nao threads logicos.
WHISPER_CPU_THREADS=4

# Quantos clipes gerar no maximo por video
MAX_CLIPS=5

# Duracao minima/maxima (em segundos) de cada clipe sugerido pelo Gemini
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=90

# Diretorio de arquivos temporarios de trabalho (apagado ao final de cada execucao bem-sucedida)
WORK_DIR=temp

# Diretorio onde os clipes finais sao salvos
OUTPUT_DIR=output

# Quantas vezes tentar um item da fila (contagem total: original + retries)
# antes de marcar como erro terminal. Vale tanto pra falha real do pipeline
# quanto pra recuperacao de itens travados em 'running' apos o processo cair.
QUEUE_MAX_RETRIES=3

# Quantos dias manter o arquivo de um clipe no disco depois de publicado, antes
# de 'shortsgen clips cleanup' apagar (o arquivo ja foi enviado pra plataforma).
CLIP_RETENTION_DAYS=10

# Quantas vezes tentar a transcricao (Whisper) e a chamada ao Gemini antes de
# desistir e marcar a execucao como erro (falhas transitorias de rede/API).
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY_SECONDS=5.0
