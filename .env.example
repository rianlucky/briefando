# Chave da API do Gemini (Google AI Studio) - usada para detectar os highlights
GEMINI_API_KEY=AI ...

# Modelo Gemini usado para escolher os highlights (opcional)
GEMINI_MODEL=gemini-3.5-flash

# Tamanho do modelo Whisper local: tiny, base, small, medium, large-v3
# "small" roda bem mais rapido em CPU que "medium"; suba de tamanho so quando
# a qualidade da transcricao/highlights precisar de mais precisao.
WHISPER_MODEL_SIZE=small

# Dispositivo do Whisper: auto, cpu, cuda
WHISPER_DEVICE=auto

# Tipo de computacao do faster-whisper: default, int8, float16, float32
# "default" deixa o CTranslate2 escolher automaticamente pro device configurado.
WHISPER_COMPUTE_TYPE=default

# Quantos clipes gerar no maximo por video
MAX_CLIPS=5

# Duracao minima/maxima (em segundos) de cada clipe sugerido pelo Gemini
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=90

# Diretorio de arquivos temporarios de trabalho (apagado ao final de cada execucao bem-sucedida)
WORK_DIR=temp

# Diretorio onde os clipes finais sao salvos
OUTPUT_DIR=output
